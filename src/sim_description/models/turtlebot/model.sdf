<sdf version="1.9">
  <model name="turtlebot">
    <pose>0 0 0.1 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.03</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.03</iyy><iyz>0.0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.28 0.22 0.12</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.28 0.22 0.12</size></box></geometry>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>0 0.1435 0.033 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.0002</iyy><iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.02</length></cylinder></geometry>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0 -0.1435 0.033 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.0002</iyy><iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.02</length></cylinder></geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>100</velocity></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>100</velocity></limit>
      </axis>
    </joint>
  </model>
</sdf>
